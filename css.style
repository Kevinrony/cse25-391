* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background: #f5f5f5;
    color: #333;
}

header {
    background: rgba(0,0,0,0.7);
    color: white;
    padding: 15px 50px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: fixed;
    width: 100%;
}

nav a {
    color: white;
    margin: 0 15px;
    text-decoration: none;
}

.hero {
    height: 100vh;
    background: url('images/leaf.jpg') no-repeat center/cover;
    display: flex;
    align-items: center;
    padding: 100px;
    color: white;
}

.hero-text {
    max-width: 500px;
}

.hero h1 {
    font-size: 50px;
    margin-bottom: 20px;
}

.btn {
    padding: 10px 20px;
    margin-right: 10px;
    border: none;
    cursor: pointer;
}

.btn-green {
    background: green;
    color: white;
}

.btn-white {
    background: white;
}

.section {
    padding: 80px 50px;
    text-align: center;
}

.about {
    display: flex;
    gap: 40px;
    align-items: center;
    justify-content: center;
}

.about img {
    width: 300px;
    border-radius: 10px;
}

.services {
    display: flex;
    gap: 20px;
    justify-content: center;
}

.card {
    background: white;
    padding: 20px;
    width: 250px;
    border-radius: 10px;
}

.gallery img {
    width: 200px;
    margin: 10px;
    border-radius: 10px;
}

form {
    max-width: 400px;
    margin: auto;
}

input, textarea {
    width: 100%;
    margin: 10px 0;
    padding: 10px;
}

footer {
    background: #222;
    color: white;
    text-align: center;
    padding: 20px;
}
